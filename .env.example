# ── Supabase ──────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ─────────────────────────────────────────────────
# URL pública (la usan los QR, las vueltas de pago y los webhooks)
NEXT_PUBLIC_SITIO_URL=http://localhost:3000
# Duración de los enlaces firmados de descarga, en segundos (900 = 15 min)
DURACION_URL_FIRMADA_SEG=900

# ── Mercado Pago (ARS) ────────────────────────────────────
# Tus integraciones → Credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=
# Tus integraciones → Webhooks → Clave secreta
MERCADOPAGO_WEBHOOK_SECRET=

# ── Stripe (USD / internacional) ──────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Developers → Webhooks → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
